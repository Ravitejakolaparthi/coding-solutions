#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >> t;
    while(t--){
        int u=0,d=0,l=0,r=0;
        string s;
        int n;
        cin >> n;
        cin >> s;
        for(int i = 0;i<n;i++){
            if(s[i] == 'U') u++;
            if(s[i] == 'D') d++;
            if(s[i] == 'L') l++;
            if(s[i] == 'R') r++;
        }
        if(u == d && r == l)
        {
            cout << "No\n";
        }
        else if(abs(u-d) >= 1 && abs(r-l) >= 1){
            cout << "No\n";
        }
        else{
            cout << "Yes\n";
        }
    }
    return 0;
}