#include <bits/stdc++.h>
using namespace std;
int main()
{
    
    int t;
    cin >>t;
    while(t--)
    {
        int n;
        cin >> n;
        vector<int>v(n);
        for(int i = 0;i<n;i++) cin >> v[i];
        int flag = 0; 
        int i = 0;
        int j = n-1;
        int s =abs(v[i]-v[j]);
        while(i < j)
        {
            i++;
            j--;
            if(s != abs(v[i]-v[j]))
            flag = 1;
            
        }
        if(flag == 1)
        cout << "No\n";
        else
        cout << "Yes\n";
     }
    return 0;
}