#include <bits/stdc++.h>
using namespace std;
int main()
{
    
    int t;
    cin >>t;
    while(t--)
    {
        int n;
        cin >> n;
        vector<int>v(n);
        for(int i = 0;i<n;i++) cin >> v[i];
        int i = 0,j = n-1;
        set<int>s;
        while(i<j)
        {
            s.insert(abs(v[i]-v[j]));
            i++;
            j--;
        }
        if(s.size() == 1)
        cout << "yes\n";
        else
        cout << "No\n";
        
     }
    return 0;
}