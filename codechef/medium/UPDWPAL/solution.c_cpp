#include <bits/stdc++.h>
using namespace std;
int main()
{
    
    int t;
    cin >>t;
    while(t--)
    {
        int flag = 0;
        int n;
        cin >> n;
        vector<int>v(n);
        for(int i = 0;i<n;i++) cin >> v[i];
        int i = 0,j = n-1;
        vector<int>res;
        while(i<=j)
        {
            res.push_back(abs(v[i]-v[j]));
            i++;
            j--;
        }
       for(int i =0;i<n;i++)
       {
           if(res[i] != 0 && res[i] != 2)
           flag = 1;
       }
       if(flag == 0)
       cout << "Yes\n";
       else
       cout << "No\n";
        
     }
    return 0;
}