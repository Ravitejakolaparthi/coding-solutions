#include <bits/stdc++.h>
using namespace std;
int main()
{
    
    int t;
    cin >>t;
    while(t--)
    {
        int n;
        vector<int>v(n);
        for(int i = 0;i<n;i++) cin >> v[i];
        int flag = 0;        
        for(int i=0;i<n-1;i++)
        {
            if(abs(v[i] - v[i+1]) != abs(v[i+1] - v[i+2]))
            {
                flag = 1;
            }
        }
        if(flag == 1)
        cout << "No\n";
        else
        cout << "Yes\n";
     }
    return 0;
}