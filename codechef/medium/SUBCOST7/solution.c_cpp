#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >> t;
    while(t--)
    {
        int n,x,y;
        cin >> n >> x >> y;
        if(n<=3)
        {
            cout << n*x <<endl;
        }
        else
        {
            cout << (n-3)*y + 3*x <<endl;
        }
    }
    return 0;
}