#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >> t;
    while(t--){
        int x,y;
        int c = 0;
        cin >> x >> y;
        int amount = 0;
        int k = 0;
        while(amount <= 0){
            
            c++;
            amount += (y*pow(k,2) - x);
            k++;
            amount += (y*pow(k,2) - x);
            
            if(amount + (y*pow(k,2)-x) > 0)break;
        }
        cout << c <<endl;
    }
    return 0;
}