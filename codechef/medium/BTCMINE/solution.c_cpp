#include <bits/stdc++.h>
using namespace std;
int solve(int amount,int x,int y,int k,int c){
    if(amount > 0){
        return c;
    }
    else{
        amount += x - y*pow(k,2); 
        solve(amount,x,y,k,c+1);
        solve(amount,x,y,k+1,c+1);
    }
}
int main()
{
    int t;
    cin >> t;
    while(t--){
        int x,y;
        int c = 0;
        cin >> x >> y;
        int amount = 0;
        int k = 1;
        cout << solve(amount,x,y,k,c) <<endl;
    }
    return 0;
}