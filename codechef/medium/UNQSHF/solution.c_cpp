#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >> t;
    while(t--){
        string s1;
        string s2;
        cin >> s1 >>s2;
        int c1 = 0;
        int c2 = 0;
        for(int i = 0;i<s1.length();i++){
            if(s1[i] == 'a')
            c1++;
            if(s2[i] == 'a')
            c2++;
        }
        if(c1 == c2)
        cout <<"YES\n";
        else cout << "NO\n";
    }
    return 0;
}