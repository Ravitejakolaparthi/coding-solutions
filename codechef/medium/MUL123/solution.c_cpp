#include <bits/stdc++.h>
using namespace std;
int solve(int n,int cnt){
    if(n%3 == 0)
    return cnt;
    else{
        cnt = min(solve(n+1,cnt),solve(ceil(n/3)*5,cnt));
        
    }
    return cnt;
    
}
int main()
{
    int t;
    cin >> t;
    while(t--){
        int n;
        cin >> n;
        int cnt = 0;
        if(n%3 == 0)
            cout << cnt << endl;
        else
         cnt = solve(n,0);

    }
    return 0;
}