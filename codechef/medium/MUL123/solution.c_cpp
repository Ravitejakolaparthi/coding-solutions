#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >> t;
    while(t--){
        int n;
        cin >> n;
        int cnt;
        if(n %  3 == 0){
            cout << 0 <<endl;
            break;
        }
        else{
            while(n%3!=0){
                
                int sum = n*(n+1)/2;
                if(sum % 3 == 0){
                    cnt++;
                    cout << cnt;
                }
                else{
                    for(int i = n;i<=n+5;i++){
                        if(i%5 == 0){
                        n = i;
                        cnt++;
                        }
                    }
                    if(n%3 == 0)
                    {
                        cout << cnt
                    }
                }
            }
            
        }
        
    }
    return 0;
}