#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;
    while(t--){
        int n, k;
        cin >> n >> k;
        int i = 1;
      
        int o = k; 
          
        if(k > n)
            cout << n << endl;
        else {
            int mi = 0;
            while(n--){
                mi++;
                if(mi == k){
                    i++;
                    n++;
                    
                    k = o * i;
                }
            }
            cout << mi << endl;
        }
    }
    return 0;
}
