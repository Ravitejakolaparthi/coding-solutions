#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >> t;
    while(t--){
        int n,k;
        cin >> n >> k;
        int i = 1;
          
         if(k > n)
         cout << n <<endl;
         else{
           int mi = 0;
             while(n--){
                 mi++;
                 if(mi == k){
                     i++;
                     n++;
                     k = k*i;
                 }
             }
             cout << mi <<endl;
         }
         
    }
    return 0;
}