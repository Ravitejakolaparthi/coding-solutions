#include <bits/stdc++.h>
using namespace std;


int solve1(int x,int y,int z,int moves)
{
    if(x*y < z)
    {
        // moves += 1;
        moves = solve1(x+1,y,z,moves) + 1;
    }
    return moves;
}
int solve3(int x,int y,int z,int moves)
{
    if(x*y < z)
    {
        moves = solve3(x+1,y+1,z,moves)+1;
    }
    return moves;
}
int solve2(int x,int y,int z,int moves)
{
    if(x*y <z)
    {
       moves =  solve2(x,y+1,z,moves) + 1;
    }
    return moves;
    
}
int main()
{
    int t;
    cin >> t;
    while(t--)
    {
        int x,y,z;
        cin >> x >>y>>z;
        int a = solve1(x,y,z,0);
        int b = solve2(x,y,z,0);
        int c = solve3(x,y,z,0);
        cout << min(a,min(c,b)) <<endl;
    }
    return 0;
}