#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >> t;
    while(t--)
    {
        int x,y,z;
        cin >> x >> y >>z;
        int cnt = 0;
        while(x*y < z)
        {
            cnt+=1;
            if(x < y)
            {
                x+=1;
            }
            else 
            {
                y+=1;
            }
        }
        cout << cnt <<endl;
    }
    return 0;
}