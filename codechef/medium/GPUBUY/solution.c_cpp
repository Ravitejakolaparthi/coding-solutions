#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >>t;
    while(t--)
    {
        
        int totalmoney = 0;
        int cp,ip,cm;
        cin >> cp >> ip >> cm;
        if(cp == ip && ip == cm)
        {
            cout << -1 << endl;
            continue;
        }
        if(ip >= cm){
             cout << -1 <<endl;
             continue;
        }
        int months = -1;
        int flag = 0;
        if(cm > cp)
        {
            if(cp+ip <= cm)
            {
                cout << 1 <<endl;
                flag = 1;
            }
            if(flag == 1)
            continue;
        }
        // totalmoney = cm;
        while(totalmoney <= cp)
        {
            months+=1;
            cp += ip;
            totalmoney+=cm;
        }
        cout << months <<endl;
    }
    
    return 0;
}