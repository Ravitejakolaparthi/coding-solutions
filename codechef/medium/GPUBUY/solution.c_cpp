#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >>t;
    while(t--)
    {
        
        int totalmoney = 0;
        int cp,ip,cm;
        cin >> cp >> ip >> cm;
        if(ip >= cm){
        cout << -1 <<endl;
        continue;
        }
        int months = -1;
        if(cm >= cp)
        {
            if(cp+ip <= cm)
            cout << 1 <<endl;
            continue;
        }
        // totalmoney = cm;
        while(totalmoney <= cp)
        {
            months+=1;
            cp += ip;
            totalmoney+=cm;
        }
        cout << months <<endl;
    }
    
    return 0;
}