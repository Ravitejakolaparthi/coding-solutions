#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >> t;
    while(t--){
        int n;
        cin >>n;
        vector<int>v(n);
        for(int i = 0;i<n;i++){
            cin >> v[i];
        }
        map<int,int>mp;
        for(int i = 0;i<n;i++){
            mp[v[i]]++;
        }
        int freq =0;
        for(auto i = mp.begin();i!=mp.end();i++){
            freq = max(freq,(i->second));
        }
        cout << (freq+1)/2 <<endl;
    }
    return 0;
}