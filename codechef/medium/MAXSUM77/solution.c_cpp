#include <bits/stdc++.h>
using namespace std;
int solve(vector<int>v,int s,int k,int l,int r){
     if(k > 0){
        s = max(solve(v,s-v[l],k,l++,r),solve(v,s-v[r],k,l,r--));
     }
}

int main()
{
    int t;
    cin >> t;
    while(t--){
        int k;
        int n;
        cin >> n;
        cin >> k;
        vector<int>arr(n);
        for(int i = 0;i<n;i++)
        {cin >> arr[i];
            sum += arr[i];
        }
        int ans = solve(arr,sum,k,0,n-1);
        cout << ans <<endl;
    }
    return 0;
}