#include <bits/stdc++.h>
using namespace std;
int main()
{
    
    int t;
    cin >> t;
    while(t--){
        int n;
        int k;
        cin >> n >> k;
        vector<int>v(n);
        for(int i = 0;i<n;i++) cin >> v[i];
         k = n - k;
        int sum = 0;
        for(int i = 0;i<k;i++){
            sum += v[i];
        }
        int maxS = sum;
        for(int i = k;i<n;i++){
            sum = sum + v[i] - v[i-k];
            maxS = max(maxS,sum);
        }
        cout << maxS <<endl;
    }
    return 0;
}