#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >> t;
    while(t--){
        int k;
        int n;
        cin >> n;
        cin >> k;
        vector<int>arr(n);
        for(int i = 0;i<n;i++) cin >> arr[i];
        
        int l = 0,r = n-1;
        while(k>0){
           int j = 0;
           if(arr[l] > arr[r]){
               j = r;
               r--;
           }else{
               j = l;
               l++;
           }
           arr[j] = 0;
           k--;
        }
        int sum = 0;
        for(int i = 0;i<n;i++){
            sum += arr[i];
        }
        cout << sum <<endl;
    }
    return 0;
}