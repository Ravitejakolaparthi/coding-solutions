#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >> t;
    while(t--){
        int n;
        cin >> n;
        string s1;
        string s2;
        cin >> s1;
        cin >> s2;
        int s1z=0,s1o=0,s2z=0,s2o=0;
        for(int i = 0;i<n;i++){
            if(s1[i] == '0')
            s1z++;
            else
            s1o++;
        } for(int i = 0;i<n;i++){
            if(s2[i] == '0')
            s2z++;
            else
            s2o++;
        }
        if(s1z == s2z && s1o == s2o)
        cout << "yes\n";
        else
        cout << "No\n";
    }
    return 0;
}