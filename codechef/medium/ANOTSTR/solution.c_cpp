#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >> t;
    while(t--){
        int n;
        cin >> n;
        string s1;
        string s2;
        cin >> s1;
        cin >> s2;
       int i = 0,j = 1;
        while (i < n) {
        	while(s1[i] != s2[i] && j < n){
        			if(s1[i] == s1[j]){
        				swap(s1[j],s1[i]);
        				if(s1[i] == '1') s1[i] = '0';
        				if(s1[i] == '0') s1[i] = '1';
        				if(s1[j] == '1') s1[j] = '0';
        				if(s1[j] == '0') s1[j] = '1';
        			}
        			j++;
        	}
        	i++;
        	j = i+1;
        }
        int flag = 0;
        for(int i = 0;i<n;i++){
            if(s1[i] != s2[i]){
               flag = 1;
            }
        }
        if(flag == 0) cout <<"yes\n";
        else cout << "No\n";
       
    }
    return 0;
}