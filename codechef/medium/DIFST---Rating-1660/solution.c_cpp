#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >> t;
    while(t--){
        int n;
        cin >> n;
        vector<int>arr(n);
        for(int i = 0;i<n;i++){
            cin >> arr[i];
        }
        int power = 999999999;
        vector<vector<int>>ans;
        vector<int>x = {0,0};
        int i = 0;
        int j = 0;
        for(i = 0;i<n;i++){
            for(j=i+1;j<n-1;j++){
                if(abs(arr[i]-arr[j]) >= abs(i-j)){
                    if(power>abs(i-j)){
                        x = {arr[i],arr[j]};
                        power = abs(i-j);
                    }
                }
            }
            ans.push_back(x);
            swap(arr[i],arr[j]);
        }
        cout << ans.size() << endl;
        for(int k = 0;k<n;k++){
            for(int l = 0;l<2;l++){
                cout << ans[k][l] <<" ";
            }
            cout << "\n";
        }
    }
    return 0;
}