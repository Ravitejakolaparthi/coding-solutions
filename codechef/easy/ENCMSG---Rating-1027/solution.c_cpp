#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >> t;
    while(t--){
        int n;
        cin >> n;
        string s;
        cin >> s;
        // int n = s.length();
        for(int i=0;i<n-1;i+=2){
            swap(s[i],s[i+1]);
        }
        // if(n%2 == 0)
        // swap(s[n-2],s[n-1]);
        for(int i=0;i<n;i++){
            s[i] = 'z' + 'a'-s[i];
        }
        
        cout << s << endl;
    }
    return 0;
}