#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >> t;
    while(t--){
        int a,b,p,q,r;
        cin >> a >> b >> p >> q >> r;
       
        int cost = 9999999;
        int j = min(a,b);
        int i = 0;
        // int cost_a = ;
        // int cost_b = ;
        int cost_d =0;
        int cost_D =0;
        for(i = 0;i<=j;i++){
            cost_d = r*i;
            cost_D =((a+1-i)/2)*p+((b+1-i)/2)*q+cost_d;
         cost = min(cost,cost_D);
        }
       
        cout << cost <<endl;
        }

    
    return 0;
}