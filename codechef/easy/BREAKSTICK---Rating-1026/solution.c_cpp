#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >> t;
    while(t--){
        long long int length,x;
        cin >> length >> x;
        if(length%2 == 0)
        cout << "Yes\n";
        else{
            if(x %2 == 1)
            cout << "Yes\n";
            else
            cout << "No\n";
        }
    }
    return 0;
}